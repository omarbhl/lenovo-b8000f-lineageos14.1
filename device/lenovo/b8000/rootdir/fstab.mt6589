# Experimental B8000-F actual partition map; avoids vendor /emmc@ aliases.
/dev/block/mmcblk0p6 /system ext4 ro,noatime wait
/dev/block/mmcblk0p8 /data ext4 noatime,nosuid,nodev,noauto_da_alloc wait
/dev/block/mmcblk0p7 /cache ext4 noatime,nosuid,nodev,noauto_da_alloc wait
/dev/block/mmcblk0p2 /protect_f ext4 noatime,nosuid,nodev,noauto_da_alloc wait
/dev/block/mmcblk0p3 /protect_s ext4 noatime,nosuid,nodev,noauto_da_alloc wait
/devices/platform/mtk-msdc.1/mmc_host* auto auto defaults voldmanaged=sdcard1:auto
