+
+static int legacy_property_allowed(const char* name, const struct ucred* cr) {
+    if (!cr) return 0;
+    // Lineage adbd uses this exact spelling, unlike AOSP service.adb.root.
+    if (cr->uid == AID_SHELL && !strcmp(name, "cm.service.adb.root")) return 1;
+    if (!strncmp(name, "ro.", 3)) name += 3;
+    if (cr->uid == AID_ROOT) return 1;
+    for (size_t i = 0; legacy_property_perms[i].prefix; ++i) {
+        const auto& rule = legacy_property_perms[i];
+        if (!strncmp(rule.prefix, name, strlen(rule.prefix)) &&
+            ((cr->uid && rule.uid == cr->uid) || (cr->gid && rule.gid == cr->gid))) return 1;
+    }
+    return 0;
+}
+
+static int legacy_control_allowed(const char* name, const struct ucred* cr) {
+    if (!cr) return 0;
+    if (cr->uid == AID_ROOT || cr->uid == AID_SYSTEM) return 1;
+    for (size_t i = 0; legacy_control_perms[i].service; ++i) {
+        const auto& rule = legacy_control_perms[i];
+        if (!strcmp(rule.service, name) &&
+            ((cr->uid && rule.uid == cr->uid) || (cr->gid && rule.gid == cr->gid))) return 1;
+    }
+    return 0;
+}
