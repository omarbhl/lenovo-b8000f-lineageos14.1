 endif
 
+# Explicit experimental legacy target only. Never enabled on another device or a user build.
+ifeq ($(B8000_LEGACY_NO_SELINUX),true)
+ifeq (,$(filter b8000 b8000_init,$(TARGET_DEVICE)))
+$(error B8000_LEGACY_NO_SELINUX is restricted to b8000/b8000_init)
+endif
+ifeq (,$(filter userdebug eng,$(TARGET_BUILD_VARIANT)))
+$(error The legacy no-SELinux init is restricted to userdebug/eng)
+endif
+init_options += -DB8000_LEGACY_NO_SELINUX=1
+endif
+
 init_options += -DLOG_UEVENTS=0
 
 ifneq ($(TARGET_INIT_COLDBOOT_TIMEOUT),)
