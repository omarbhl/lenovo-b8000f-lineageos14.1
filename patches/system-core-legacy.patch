diff --git a/init/legacy_no_selinux.h b/init/legacy_no_selinux.h
new file mode 100644
index 0000000..2273be2
--- /dev/null
+++ b/init/legacy_no_selinux.h
@@ -0,0 +1,10 @@
+// Experimental B8000-F stock-kernel bring-up only; not a permissive-SELinux switch.
+#pragma once
+
+static inline bool LegacyNoSelinux() {
+#if defined(B8000_LEGACY_NO_SELINUX) && B8000_LEGACY_NO_SELINUX
+    return true;
+#else
+    return false;
+#endif
+}
